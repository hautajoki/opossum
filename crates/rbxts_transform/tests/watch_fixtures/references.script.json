{
	"steps": [
		{
			"name": "a body edit in a referenced project (its declarations unchanged)",
			"do": [{ "patch": { "file": "projects/common/src/index.ts", "find": "total += value;", "replace": "total += value * 1;" } }]
		},
		{
			"name": "a referenced type change reaches the root's Luau (`+` becomes `..`)",
			"do": [{ "patch": { "file": "projects/common/src/index.ts", "find": "export let label: number = 0;", "replace": "export let label: string = \"\";" } }]
		},
		{
			"name": "back to a number",
			"do": [{ "patch": { "file": "projects/common/src/index.ts", "find": "export let label: string = \"\";", "replace": "export let label: number = 0;" } }]
		},
		{
			"name": "an error in the deepest reference: nothing is built",
			"do": [{ "patch": { "file": "projects/common/src/index.ts", "find": "export function add(value: number)", "replace": "export function add(value: nmber)" } }],
			"expect": "error"
		},
		{
			"name": "the error fixed",
			"do": [{ "patch": { "file": "projects/common/src/index.ts", "find": "export function add(value: nmber)", "replace": "export function add(value: number)" } }]
		},
		{
			"name": "an error in the root alone",
			"do": [{ "patch": { "file": "src/greet.ts", "find": "return `hello ${name}`;", "replace": "return `hello ${nam}`;" } }],
			"expect": "error"
		},
		{
			"name": "the root's error fixed",
			"do": [{ "patch": { "file": "src/greet.ts", "find": "return `hello ${nam}`;", "replace": "return `hello ${name}`;" } }]
		},
		{
			"name": "a new file in a referenced project, exported to the root",
			"do": [
				{ "write": { "file": "projects/common/src/extra.ts", "text": "export function extra(value: number) {\n\treturn value * 3;\n}\n" } },
				{ "append": { "file": "projects/common/src/index.ts", "text": "export { extra } from \"./extra\";\n" } },
				{ "append": { "file": "src/main.server.ts", "text": "print(common.extra(2));\n" } }
			]
		},
		{
			"name": "that file deleted again",
			"do": [
				{ "patch": { "file": "src/main.server.ts", "find": "print(common.extra(2));\n", "replace": "" } },
				{ "patch": { "file": "projects/common/src/index.ts", "find": "export { extra } from \"./extra\";\n", "replace": "" } },
				{ "delete": "projects/common/src/extra.ts" }
			]
		},
		{
			"name": "a hand-deleted declaration of a referenced project",
			"do": [{ "delete-output": "projects/common/out/types/index.d.ts" }]
		},
		{
			"name": "a hand-deleted Luau output of a referenced project",
			"do": [{ "delete-output": "projects/shared/out/init.luau" }]
		},
		{
			"name": "a referenced project's tsconfig edit (declaration maps off)",
			"do": [{ "patch": { "file": "projects/common/tsconfig.json", "find": "\"declarationMap\": true,", "replace": "\"declarationMap\": false," } }]
		},
		{
			"name": "a declaration asset edit in a referenced project",
			"do": [{ "patch": { "file": "projects/common/src/native.d.ts", "find": "right: number", "replace": "right?: number" } }]
		},
		{
			"name": "an unchanged save in a referenced project",
			"do": [{ "touch": "projects/shared/src/index.ts" }]
		},
		{
			"name": "an edit in the root alone: both referenced projects are skipped",
			"do": [{ "patch": { "file": "src/greet.ts", "find": "return `hello ${name}`;", "replace": "return `hi ${name}`;" } }]
		},
		{
			"name": "an edit in shared alone: common is skipped",
			"do": [{ "patch": { "file": "projects/shared/src/index.ts", "find": "public name = \"shared\";", "replace": "public name = \"shared!\";" } }]
		},
		{
			"name": "an error in common and a root edit in one build: nothing is written",
			"do": [
				{ "patch": { "file": "projects/common/src/index.ts", "find": "export function add(value: number)", "replace": "export function add(value: nmber)" } },
				{ "patch": { "file": "src/greet.ts", "find": "return `hi ${name}`;", "replace": "return `hey ${name}`;" } }
			],
			"expect": "error"
		},
		{
			"name": "a root edit while common still fails: common is built again and reports its error",
			"do": [{ "patch": { "file": "src/greet.ts", "find": "return `hey ${name}`;", "replace": "return `hello ${name}`;" } }],
			"expect": "error"
		},
		{
			"name": "an edit in shared while common still fails",
			"do": [{ "patch": { "file": "projects/shared/src/index.ts", "find": "public name = \"shared!\";", "replace": "public name = \"shared\";" } }],
			"expect": "error"
		},
		{
			"name": "common fixed: every project builds the edits made while it failed",
			"do": [{ "patch": { "file": "projects/common/src/index.ts", "find": "export function add(value: nmber)", "replace": "export function add(value: number)" } }]
		}
	]
}
