// roblox-ts's transform order (`getChangedFilePaths` of a clean build), which rbxts-rs builds in
// (`build::transform_order`): imports, a triple-slash reference, a module augmentation, an import of an ambient
// module and a module file augmenting that ambient module (`a_augamb.ts`: its importer `f.ts` follows it, before
// `a_plain.ts`), a type import matched by two pattern ambient modules (`z_h.ts` follows the longer prefix's
// `a_pat2.d.ts`, after `a_pat1.ts`) and one of an ambient module whose name also resolves to a file (`z_i.ts`
// follows `a_shadow.d.ts`, not `zz_shadowed.ts`) make it differ from program order. `expected/`: stock roblox-ts's `rbxtsc build` output; `order.txt`: the
// order stock transforms the files in (`getChangedSourceFiles` on a fresh builder), which `tests/fixtures.rs` checks.
{
	"include": ["src"],
	"compilerOptions": {
		"allowSyntheticDefaultImports": true,
		"module": "preserve",
		"moduleResolution": "bundler",
		"noLib": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"moduleDetection": "force",
		"strict": true,
		"target": "ESNext",
		"typeRoots": ["node_modules/@rbxts"],
		"types": ["types", "compiler-types"],
		"experimentalDecorators": true,
		"rootDir": "src",
		"outDir": "out",
		"paths": { "*": ["./src/*"] }
	}
}
